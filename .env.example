# Environment Variables for Spendly
# Copy this file to .env and fill in your Supabase connection details

# Option 1: Supabase PostgreSQL Connection String (Session Pooler or Direct)
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# JWT Secret Key (Any long secure random string)
SECRET_KEY=spendly-super-secret-key-change-this-in-production
